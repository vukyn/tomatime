# Environment
.env

# Build output
bin/

# SQLite database
db/app.db

# Scratch
todo

# Knowledge graph cache
.code-review-graph/

# Node
node_modules/
ui/.vite/

# Built UI assets — embedded by internal/web at build time via `make build-web`.
# Only the placeholder internal/web/dist/.gitkeep is committed so go:embed and
# `go build` work on a fresh checkout without first building the frontend.
internal/web/dist/*
!internal/web/dist/.gitkeep
ui/dist/

# Claude Code local config
# Machine-local Claude state. Everything is ignored EXCEPT the repo-root
# agent-memory, which is knowledge about this repo and has to travel with it.
# ⚠️ A .claude/ below the root is a store an agent made because a session's cwd
# was a subdirectory — same knowledge, invisible to the repo's own agent. Those
# stay ignored; consolidate their notes into the root store instead.
**/.claude/
!/.claude/
/.claude/*
!/.claude/agent-memory

# MacOS
.DS_Store
